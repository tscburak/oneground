{
  "name": "oneground",
  "version": "0.3.1",
  "private": false,
  "description": "Open-source playground and evaluation toolkit for testing, comparing, and benchmarking decision models before integration.",
  "keywords": [
    "nextjs",
    "system-one",
    "evaluation",
    "llm",
    "typescript"
  ],
  "homepage": "https://github.com/tscburak/oneground#readme",
  "bugs": "https://github.com/tscburak/oneground/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tscburak/oneground.git"
  },
  "bin": {
    "oneground": "bin/oneground.js"
  },
  "files": [
    "bin/oneground.js",
    ".next/standalone/",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev -p 3180",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "prepack": "npm run build",
    "start": "next start",
    "oneground": "node bin/oneground.js",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "driver.js": "^1.8.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
