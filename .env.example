# Optional bootstrap values, imported into SQLite once on first initialization.
# Manage saved keys/models through Settings after initialization.
TYPESAFE_API_KEY=
# Local System One endpoint (initial profile only)
KEV_BASE_URL=http://127.0.0.1:8008

# App settings (persistent local database and optional OpenAI-compatible LLM)
ONEGROUND_DB_PATH=data/oneground.sqlite
LLM_API_KEY=
LOCAL_SYSTEM_ONE_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# Optional stable base64-encoded 32-byte encryption key.
# If empty, data/.settings.key is generated automatically beside the database.
ONEGROUND_SETTINGS_KEY=
