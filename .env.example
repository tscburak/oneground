# App settings (persistent local database)
# Default when unset is a per-user data dir (no repo writes, safe for
# global installs): ~/.local/share/oneground/oneground.sqlite on Linux
# ($XDG_DATA_HOME respected), ~/Library/Application Support/oneground on
# macOS, %APPDATA%/oneground on Windows. Set a path for project-local data.
ONEGROUND_DB_PATH=
# Optional stable base64-encoded 32-byte encryption key.
# If empty, a .settings.key file is generated automatically beside the database.
ONEGROUND_SETTINGS_KEY=
